{
  "name": "pi-plexusterm-themes",
  "version": "0.1.0",
  "description": "Terminal-relative Pi theme for PlexusTerm with an optional apply command",
  "keywords": ["pi-package", "theme", "plexusterm", "gentle-shell"],
  "homepage": "https://github.com/jorgealonsodev/pi-plexusterm-themes#readme",
  "bugs": {
    "url": "https://github.com/jorgealonsodev/pi-plexusterm-themes/issues"
  },
  "license": "MIT",
  "author": "Jorge Alonso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgealonsodev/pi-plexusterm-themes.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "files": ["extensions", "themes", "README.md"],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./extensions/plexusterm-theme/index.mjs"],
    "themes": ["./themes/*.json"]
  }
}
